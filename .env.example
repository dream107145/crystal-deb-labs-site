# Resend — contact form emails, verification, bulk email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Crystal Dev Labs <noreply@contact.crystaldevlabs.com>
ADMIN_EMAIL=your-admin@example.com

# Optional: Discord webhook for contact form submissions
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Public site URL (used in sitemap, metadata, verification emails)
NEXT_PUBLIC_SITE_URL=https://crystaldevlabs.com

# Supabase — auth, database, storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
